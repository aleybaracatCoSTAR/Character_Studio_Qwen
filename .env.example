# These are examples, not a file the app automatically executes.
# Set these in the GPU terminal; do not put credentials here.
QWEN_STORE=/scratch4weeks/YOUR_USERNAME/qwen-character-store
QWEN_MODEL_DIR=/scratch4weeks/YOUR_USERNAME/qwen-character-store/model
QWEN_PORT=18091
QWEN_ATTENTION=sdpa

# Optional live profiles: shared, quality-2gpu, quality-3gpu
# LIVE_PROFILE=quality-3gpu
# LIVE_DIRECTOR_TIMEOUT=12
# Optional native streaming comparison. The baseline remains the default.
# LIVE_OMNI_URL=http://127.0.0.1:18097
# LIVE_OMNI_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
# LIVE_DEFAULT_ENGINE=baseline
